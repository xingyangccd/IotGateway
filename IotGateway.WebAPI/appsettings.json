{
  "// ============================================================": "",
  "// ASP.NET Core 配置文件（企业级版本）": "",
  "// 配置读取顺序（后面的覆盖前面的）：": "",
  "//   appsettings.json → appsettings.Development.json → 环境变量 → 命令行参数": "",
  "// ============================================================": "",

  "// ============================================================": "",
  "// 数据库连接（EF Core + Pomelo.EntityFrameworkCore.MySql）": "",
  "// ============================================================": "",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=iot_gateway;User=iot_user;Password=Iot@2024;Charset=utf8mb4;"
    // Server：MySQL 服务器地址（localhost = Docker 容器暴露的端口）
    // Port：MySQL 端口（docker-compose 中暴露的 3306）
    // Database：数据库名称（sql/01-init-database.sql 中创建的 iot_gateway）
    // User：数据库用户名（docker-compose 中创建的 iot_user）
    // Password：数据库密码（docker-compose 中配置的 Iot@2024）
    // Charset：字符集（utf8mb4 = 支持 Emoji 的 UTF-8）
  },

  "// ============================================================": "",
  "// Serilog 结构化日志配置": "",
  "// ============================================================": "",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "// ============================================================": "",
  "// JWT 认证配置": "",
  "// ============================================================": "",
  "Jwt": {
    "Key": "IotGateway_SuperSecret_Key_2024_Must_Be_At_Least_32_Chars!",
    "Issuer": "IotGateway",
    "Audience": "IotGateway_Client",
    "ExpireHours": 8
  },

  "// ============================================================": "",
  "// 应用配置": "",
  "// ============================================================": "",
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000"
  // WPF 客户端通过 http://localhost:5000 访问 API
  // Vue3 前端也可通过此地址访问
}
