<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>IotGateway.WPF</RootNamespace>
    <AssemblyName>IotGateway.WPF</AssemblyName>
  </PropertyGroup>

  <!-- NuGet 包引用 -->
  <ItemGroup>
    <!-- Prism 模块化框架：提供 MVVM、Region导航、EventAggregator、DI容器 -->
    <PackageReference Include="Prism.Unity" Version="9.0.537" />

    <!-- .NET 8 中 System.IO.Ports 已内置，但 WPF 项目可能需要显式引用 -->
    <!-- System.Net.Http 已内置在框架中，无需额外安装 -->
  </ItemGroup>

</Project>
