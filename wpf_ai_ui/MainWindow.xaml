<!--
============================================================
文件：MainWindow.xaml
用途：应用主窗口
     作为 Shell 容器，动态切换显示登录页和主内容页
     Prism 会通过 Region 机制管理页面切换
============================================================
-->

<Window x:Class="IotGateway.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IotGateway.WPF"
        mc:Ignorable="d"
        Title="工业物联网设备全生命周期管理系统"
        Height="700"
        Width="1200"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#ECF0F1">

    <!--
    主窗口的内容只是一个 ContentControl
    作为 Prism Region，由导航服务动态加载不同的 View
    登录时显示 LoginView，登录后切换到主内容页面
    -->
    <ContentControl x:Name="MainRegion"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
</Window>
